# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# MONGO_URI: MongoDB Cloud (Atlas) connection string.
# Required for the real MongoDB database. If empty/missing, the server
# automatically falls back to the in-memory demo database.
# Example: mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/taleem_lms
MONGO_URI=""

# MONGO_DIRECT_URI: Optional direct (non-SRV) connection string. Used
# automatically when the SRV URI fails (e.g. networks where Node.js cannot
# resolve SRV records). Get replicaSet/authSource from the cluster TXT record.
MONGO_DIRECT_URI=""

# VITE_API_URL: Frontend API base URL. Defaults to /api/v1 (same origin),
# which works with the Express server on port 3000. Override only if the
# frontend is hosted separately, e.g. http://localhost:3000/api/v1
VITE_API_URL=""

# SUPER_ADMIN_URL: Public URL of the Super Admin console (separate domain).
# The Super Admin SPA lives at the /admin route — map your subdomain to it
# with a reverse proxy, e.g.:
#   admin.taleemlms.com  →  https://<host>/admin
SUPER_ADMIN_URL=""

# JWT_SECRET: Secret used to sign access tokens (24h expiry).
JWT_SECRET="taleem_lms_super_secret_jwt_key_2026_pakistan"

# JWT_REFRESH_SECRET: Secret used to sign refresh tokens (7d expiry).
JWT_REFRESH_SECRET="taleem_lms_super_secret_refresh_key_2026"